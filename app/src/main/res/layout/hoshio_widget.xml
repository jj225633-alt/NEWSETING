<?xml version="1.0" encoding="utf-8"?>
<!-- 星汐: 精简的桌面小工具：名字与时间一行，下面两行是他最新说的话 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hoshio_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/hoshio_widget_bg"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:paddingStart="14dp"
  android:paddingTop="10dp"
  android:paddingEnd="14dp"
  android:paddingBottom="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/hoshio_widget_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="✦ 時澈"
      android:textColor="#FFFFE8AA"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/hoshio_widget_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#99FFFFFF"
      android:textSize="10sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/hoshio_widget_message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:ellipsize="end"
    android:lineSpacingExtra="1dp"
    android:maxLines="2"
    android:text="點這裡和他聊天"
    android:textColor="#F2FFFFFF"
    android:textSize="13sp" />
</LinearLayout>
